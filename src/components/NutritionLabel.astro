---
// What's in a glass of whole cow's milk, set like the label on a carton.
const rows = [
  { name: 'Water', amount: '87.8%' },
  { name: 'Lactose (milk sugar)', amount: '4.8%' },
  { name: 'Fat', amount: '3.4%' },
  { name: 'Protein', amount: '3.3%' },
  { name: 'Casein', amount: '2.6%', sub: true },
  { name: 'Whey', amount: '0.7%', sub: true },
  { name: 'Minerals', amount: '0.7%' },
  { name: 'Calcium, per glass', amount: '300 mg', sub: true },
];
---

<figure class="label">
  <figcaption class="label__title">Milk facts</figcaption>
  <p class="label__serving"><span>Serving size</span><span>1 glass (250 ml)</span></p>
  <p class="label__calories"><span>Calories</span><span>150</span></p>
  <table>
    <thead>
      <tr>
        <th scope="col">What's in it</th>
        <th scope="col">By weight</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class:list={{ sub: row.sub }}>
            <th scope="row">{row.name}</th>
            <td>{row.amount}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="label__note">Typical values for whole cow's milk. They vary with breed, season and feed.</p>
</figure>

<style>
  .label {
    margin: 0;
    padding: 0.75rem 1rem 1rem;
    border: 3px solid var(--ink);
    background: var(--milk);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.3;
  }

  .label__title {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--ink);
    font-size: 2.625rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .label__serving,
  .label__calories {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .label__serving {
    padding-block: 0.375rem;
    border-bottom: 10px solid var(--ink);
    font-weight: 700;
  }

  .label__calories {
    align-items: baseline;
    padding-block: 0.25rem 0.375rem;
    border-bottom: 5px solid var(--ink);
    font-size: 1.75rem;
    font-weight: 900;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--ink);
    text-align: left;
    font-weight: 700;
  }

  td {
    text-align: right;
  }

  thead th {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sub th,
  .sub td {
    font-weight: 400;
  }

  .sub th {
    padding-left: 1.25rem;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 5px solid var(--ink);
  }

  .label__note {
    padding-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
